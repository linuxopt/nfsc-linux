{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "NFSC Linux",
  "repo": "linuxopt/nfsc-linux",
  "inputs": [
    {
      "id": "game",
      "role": "game",
      "label": "Your disc image (.iso) of Need for Speed: Carbon Collector's Edition for Xbox 360, USA.",
      "formats": [{ "type": "file", "extensions": ["iso"] }],
      "check": { "ids": ["454107EC"] }
    }
  ],
  "prepare": {
    "program": ["NFSC-Linux-x86_64.AppImage", "AppRun"],
    "args": ["--prepare", "--game={input:game}"],
    "label": "Installing the game from your disc and building it for your CPU",
    "done": ["{local}/speedbreaker-carbon/game/default.xex"],
    "keeps_copy": true
  },
  "start": {
    "program": ["NFSC-Linux-x86_64.AppImage", "AppRun"],
    "args": ["--play"]
  },
  "config": [
    { "id": "main", "format": "toml", "file": [{ "path": "{local}/speedbreaker-carbon/settings.toml" }] },
    { "id": "launcher", "format": "ini", "file": [{ "path": "{local}/speedbreaker-carbon/launcher.ini" }] }
  ],
  "settings": [
    {
      "id": "window", "label": "Window", "group": "Video",
      "help": "Fullscreen fills the screen with a borderless window. Big Picture mode always plays full screen.",
      "choices": [
        { "label": "Fullscreen", "set": { "video/fullscreen": "true" } },
        { "label": "Windowed", "set": { "video/fullscreen": "false" } }
      ],
      "defaults": { "video/fullscreen": "false" }
    },
    {
      "id": "resolution", "label": "Internal resolution", "group": "Video",
      "help": "What the 3D scene is drawn at. 1x is the console's 720p, 1.5x is 1080p. Auto picks from your screen and graphics card.",
      "choices": [
        { "label": "Auto", "set": { "video/internal_resolution": "\"auto\"" } },
        { "label": "1x (720p)", "set": { "video/internal_resolution": "\"1x\"" } },
        { "label": "1.5x (1080p)", "set": { "video/internal_resolution": "\"1.5x\"" } },
        { "label": "2x (1440p)", "set": { "video/internal_resolution": "\"2x\"" } },
        { "label": "3x (4K)", "set": { "video/internal_resolution": "\"3x\"" } }
      ],
      "defaults": { "video/internal_resolution": "\"auto\"" }
    },
    {
      "id": "frame_rate", "label": "Frame rate", "group": "Video",
      "help": "The game keeps its speed at either. Auto drops to 30 when the PC can't hold 60.",
      "choices": [
        { "label": "60", "set": { "video/frame_rate": "\"60\"" } },
        { "label": "Auto", "set": { "video/frame_rate": "\"auto\"" } },
        { "label": "30", "set": { "video/frame_rate": "\"30\"" } }
      ],
      "defaults": { "video/frame_rate": "\"60\"" }
    },
    {
      "id": "vsync", "label": "V-Sync", "group": "Video",
      "help": "Shows each frame on a display refresh. Off can tear, but frames appear sooner.",
      "choices": [
        { "label": "On", "set": { "video/vsync": "true" } },
        { "label": "Off", "set": { "video/vsync": "false" } }
      ],
      "defaults": { "video/vsync": "true" }
    },
    {
      "id": "upscaling", "label": "Upscaling", "group": "Video",
      "help": "How the picture is enlarged to the window. FSR 1 keeps edges smooth when the window is much larger than the internal resolution.",
      "choices": [
        { "label": "Bicubic", "set": { "video/scaling": "\"bicubic\"" } },
        { "label": "Bilinear", "set": { "video/scaling": "\"linear\"" } },
        { "label": "FSR 1", "set": { "video/scaling": "\"fsr1\"" } }
      ],
      "defaults": { "video/scaling": "\"bicubic\"" }
    },
    {
      "id": "unlock_all", "label": "Unlock all", "group": "Game",
      "help": "Every car, part, race and DLC unlocked from the start. Your saves don't keep it: turn it off and your own progress is back.",
      "in": "launcher",
      "choices": [
        { "label": "Off", "set": { "unlock_all": "false" } },
        { "label": "On", "set": { "unlock_all": "true" } }
      ],
      "defaults": { "unlock_all": "false" }
    },
    {
      "id": "hidden_cops", "label": "Police cars in Quick Race", "group": "Game",
      "help": "15 of the game's cop cars at the end of car select's Stock list. Only while you're in Quick Race: saves never keep them.",
      "in": "launcher",
      "choices": [
        { "label": "Off", "set": { "hidden_cops": "false" } },
        { "label": "On", "set": { "hidden_cops": "true" } }
      ],
      "defaults": { "hidden_cops": "false" }
    },
    {
      "id": "hidden_dev", "label": "Developer and story cars in Quick Race", "group": "Game",
      "help": "28 test, demo and story cars (the bosses' and the crew's, a fire truck) in Quick Race's Stock list.",
      "in": "launcher",
      "choices": [
        { "label": "Off", "set": { "hidden_dev": "false" } },
        { "label": "On", "set": { "hidden_dev": "true" } }
      ],
      "defaults": { "hidden_dev": "false" }
    },
    {
      "id": "hidden_debug_menu", "label": "Debug car menu", "group": "Game",
      "help": "CAR(DEBUG) as the main menu's last option: EA's debug screen for every vehicle and part.",
      "in": "launcher",
      "choices": [
        { "label": "Off", "set": { "hidden_debug_menu": "false" } },
        { "label": "On", "set": { "hidden_debug_menu": "true" } }
      ],
      "defaults": { "hidden_debug_menu": "false" }
    }
  ],
  "saves": ["{local}/speedbreaker-carbon/save"],
  "folders": {
    "game": [{ "path": "{local}/speedbreaker-carbon/game" }],
    "saves": [{ "path": "{local}/speedbreaker-carbon/save" }],
    "logs": [{ "path": "{local}/speedbreaker-carbon/logs" }]
  },
  "exit_codes": { "0": "ok" },
  "system": {
    "linux": { "graphics": { "vulkan": "1.2" } }
  }
}
